@startuml DiagramaClases_Backend_Presentacion

' ═══════════════════════════════════════════════════════════════
' DIAGRAMA DE CLASES - BACKEND
' Sistema de Gestión de Ayudantes de Investigación
' Facultad de Ingeniería de Sistemas - EPN
' ═══════════════════════════════════════════════════════════════

skinparam classAttributeIconSize 0
skinparam shadowing true
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 120
skinparam backgroundcolor transparent

' Paleta de colores profesional
skinparam class {
    BackgroundColor<<Entidad>> #E3F2FD
    BackgroundColor<<DAO>> #FFF9C4
    BackgroundColor<<Servicio>> #C8E6C9
    BorderColor #1976D2
    ArrowColor #424242
    FontSize 12
}

title \n<size:20><b>SISTEMA DE GESTIÓN DE AYUDANTES DE INVESTIGACIÓN</b></size>\n<size:14>Backend - Lógica de Negocio y Persistencia</size>\n

' ═════════════════════════════════════════════════════════════
' CAPA DE DOMINIO (ENTIDADES)
' ═════════════════════════════════════════════════════════════

package "📦 Capa de Dominio" {
  
  abstract class MiembroEPN <<Entidad>> {
    # codigoUnico : String
    # cedula : String
    # correoInstitucional : String
    # password : String
    # nombres : String
    # apellidos : String
    # telefono : String
    # rol : String
    # estado : String
    __
    + getNombresCompletos() : String
    + autenticar(password: String) : boolean
    + esActivo() : boolean
  }
  
  class Director <<Entidad>> {
    - proyectoAsignado : ProyectoInvestigacion
    - ayudanteDAO : AyudanteDAO
    - proyectoDAO : ProyectoDAO
    - estudianteDAO : EstudianteDAO
    - jefaDepartamento : JefaDepartamento
    __
    + registrarAyudante(ayudante: Ayudante) : ResultadoOperacion
    + darDeBajaAyudante(ayudante: Ayudante, motivo: String, fecha: Date) : ResultadoOperacion
    + consultarAyudantesDelProyecto() : List<Ayudante>
    + buscarEstudiante(criterio: String) : Estudiante
  }
  
  class JefaDepartamento <<Entidad>> {
    - {static} instancia : JefaDepartamento
    - notificaciones : List<Notificacion>
    - proyectoDAO : ProyectoDAO
    - ayudanteDAO : AyudanteDAO
    __
    + {static} getInstancia() : JefaDepartamento
    + recibirNotificacion(notif: Notificacion) : void
    + getNotificacionesNoLeidas() : List<Notificacion>
    + filtrarAyudantes(filtros: Map) : List<Ayudante>
    + consultarTodosLosProyectos() : List<ProyectoInvestigacion>
  }
  
  class Ayudante <<Entidad>> {
    - carrera : String
    - nivel : int
    - IRA : float
    - fechaRegistro : Date
    - fechaFinalizacion : Date
    - motivoSalida : String
    - proyectoAsignado : ProyectoInvestigacion
    - horasSemanales : int
    - salarioMensual : double
    __
    + esActivo() : boolean
    + darDeBaja(motivo: String, fecha: Date) : void
    + calcularSalarioTotal() : double
  }
  
  class Estudiante <<Entidad>> {
    - carrera : String
    - IRA : float
    - nivel : int
    __
    + esElegibleParaAyudantia() : boolean
    + convertirAAyudante(proyecto, horas, salario) : Ayudante
  }
  
  class ProyectoInvestigacion <<Entidad>> {
    - codigoProyecto : String
    - nombreProyecto : String
    - descripcion : String
    - fechaInicio : Date
    - fechaFin : Date
    - estado : String
    - tipoProyecto : TipoProyecto
    - ayudantesPlanificados : int
    - ayudantes : List<Ayudante>
    - director : Director
    __
    + agregarAyudante(ayudante: Ayudante) : boolean
    + removerAyudante(ayudante: Ayudante) : boolean
    + getAyudantesActivos() : int
    + tieneCupoDisponible() : boolean
  }
  
  enum TipoProyecto <<Entidad>> {
    INTERNO
    SEMILLA
    GRUPALES
    VINCULACION_CON_FINANCIAMIENTO
    TRANSFERENCIA_TECNOLOGICA
  }
  
  class Notificacion <<Entidad>> {
    - idNotificacion : String
    - fecha : Date
    - mensaje : String
    - tipo : String
    - leida : boolean
    - proyectoRelacionado : ProyectoInvestigacion
    - ayudanteRelacionado : Ayudante
    __
    + marcarComoLeida() : void
  }
  
  class Reporte <<Entidad>> {
    - idReporte : String
    - fechaGeneracion : Date
    - tipo : String
    - titulo : String
    - contenido : String
    - estadisticas : Map<String,Object>
    __
    + exportarPDF() : File
    + exportarExcel() : File
  }
}

' ═════════════════════════════════════════════════════════════
' CAPA DE SERVICIOS
' ═════════════════════════════════════════════════════════════

package "⚙️ Capa de Servicios" {
  
  class GeneradorReportes <<Servicio>> {
    - proyectoDAO : ProyectoDAO
    - ayudanteDAO : AyudanteDAO
    __
    + generarReporteGeneral() : Reporte
    + generarReportePorProyecto(proyecto) : Reporte
    + generarReportePorCarrera(carrera) : Reporte
    + generarReportePorNivel(nivel) : Reporte
    + calcularEstadisticas(ayudantes) : Map
  }
  
  class ResultadoOperacion <<Servicio>> {
    - exitoso : boolean
    - mensaje : String
    - errores : List<String>
    __
    + esExitoso() : boolean
    + getMensaje() : String
    + agregarError(error: String) : void
  }
}

' ═════════════════════════════════════════════════════════════
' CAPA DE PERSISTENCIA (DAO)
' ═════════════════════════════════════════════════════════════

package "💾 Capa de Persistencia" {
  
  interface IDAO<T> <<DAO>> {
    + guardar(objeto: T) : boolean
    + buscarPorId(id: String) : T
    + listarTodos() : List<T>
    + actualizar(objeto: T) : boolean
    + eliminar(id: String) : boolean
  }
  
  class MiembroEPNDAO <<DAO>> {
    + buscarPorCorreo(correo: String) : MiembroEPN
    + buscarPorRol(rol: String) : List<MiembroEPN>
  }
  
  class AyudanteDAO <<DAO>> {
    + buscarPorProyecto(codigoProyecto: String) : List<Ayudante>
    + buscarActivos() : List<Ayudante>
    + buscarPorCarrera(carrera: String) : List<Ayudante>
    + buscarPorNivel(nivel: int) : List<Ayudante>
  }
  
  class ProyectoDAO <<DAO>> {
    + buscarPorDirector(codigoUnico: String) : ProyectoInvestigacion
    + buscarActivos() : List<ProyectoInvestigacion>
    + buscarPorCodigo(codigo: String) : ProyectoInvestigacion
  }
  
  class EstudianteDAO <<DAO>> {
    + buscarPorCodigo(codigo: String) : Estudiante
    + buscarPorCedula(cedula: String) : Estudiante
    + buscarPorCriterio(criterio: String) : Estudiante
    + buscarElegibles() : List<Estudiante>
  }
  
  IDAO <|.. MiembroEPNDAO
  IDAO <|.. AyudanteDAO
  IDAO <|.. ProyectoDAO
  IDAO <|.. EstudianteDAO
}

' ═════════════════════════════════════════════════════════════
' RELACIONES PRINCIPALES
' ═════════════════════════════════════════════════════════════

' Herencia
MiembroEPN <|-- Director
MiembroEPN <|-- JefaDepartamento
MiembroEPN <|-- Ayudante
MiembroEPN <|-- Estudiante

' Asociaciones de Dominio
Director "1" o-- "0..1" ProyectoInvestigacion : gestiona >
ProyectoInvestigacion "1" o-- "1" Director : dirigido por <
ProyectoInvestigacion "1" *-- "0..*" Ayudante : tiene >
ProyectoInvestigacion "1" -- "1" TipoProyecto

Ayudante "0..*" --> "0..1" ProyectoInvestigacion : trabaja en >

JefaDepartamento "1" *-- "0..*" Notificacion : recibe >
Notificacion "0..*" --> "0..1" ProyectoInvestigacion
Notificacion "0..*" --> "0..1" Ayudante

' Uso de DAOs
Director "1" --> "1" AyudanteDAO : usa >
Director "1" --> "1" ProyectoDAO : usa >
Director "1" --> "1" EstudianteDAO : usa >
Director "1" --> "1" JefaDepartamento : notifica >

JefaDepartamento "1" --> "1" ProyectoDAO : usa >
JefaDepartamento "1" --> "1" AyudanteDAO : usa >

' Servicios
GeneradorReportes "1" --> "1" ProyectoDAO : usa >
GeneradorReportes "1" --> "1" AyudanteDAO : usa >
GeneradorReportes "1" ..> "0..*" Reporte : << crea >>

Estudiante "1" ..> "0..1" Ayudante : << convierte >>

' ═════════════════════════════════════════════════════════════
' NOTAS EXPLICATIVAS
' ═════════════════════════════════════════════════════════════

note top of MiembroEPN
  <b>Patrón: Herencia</b>
  Clase base para todos
  los usuarios del sistema
end note

note right of JefaDepartamento
  <b>Patrón: Singleton</b>
  Solo existe una instancia
  de la Jefa de Departamento
end note

note bottom of EstudianteDAO
  <b>Búsqueda Inteligente</b>
  Detecta automáticamente si
  el criterio es código único
  o cédula
end note

note right of Estudiante
  <b>Patrón: Factory Method</b>
  convertirAAyudante() crea
  un Ayudante desde los datos
  del Estudiante
end note

note top of GeneradorReportes
  <b>Servicio de Negocio</b>
  Genera reportes con
  estadísticas de ayudantes
end note

' ═════════════════════════════════════════════════════════════
' LEYENDA
' ═════════════════════════════════════════════════════════════

legend bottom left
  <b>RESUMEN DEL SISTEMA</b>
  
  <b>Total de Clases:</b> 15
  • Entidades de Dominio: 10
  • DAOs (Persistencia): 4 + 1 interfaz
  • Servicios: 2
  
  <b>Patrones Aplicados:</b>
  • Singleton (JefaDepartamento)
  • Factory Method (Estudiante → Ayudante)
  • DAO (Acceso a Datos)
  • Herencia (MiembroEPN)
  
  <b>Base de Datos:</b>
  • SQLite (gestion_ayudantes.db)
  • 570 estudiantes precargados (data.db)
  
  <b>Funcionalidades Principales:</b>
  ✓ Registro de ayudantes
  ✓ Dar de baja ayudantes
  ✓ Consultas y filtros
  ✓ Generación de reportes
  ✓ Notificaciones automáticas
endlegend

@enduml
