@startuml DiagramaUML_GestionAyudantes_Simplificado

' Configuración
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam class {
    BackgroundColor LightBlue
    BorderColor Black
}

' Colores por tipo
skinparam class {
    BackgroundColor<<Dominio>> LightBlue
    BackgroundColor<<Gestor>> LightGreen
    BackgroundColor<<Sistema>> LightCoral
    BackgroundColor<<Persistencia>> Wheat
    BackgroundColor<<Controlador>> LightCyan
    BackgroundColor<<Vista>> LightPink
}

' ==================== CLASES DE DOMINIO ====================

package "Dominio" {
    
    abstract class MiembroFIS <<Dominio>> {
        - numeroUnico: String
        - cedula: String
        - correoInstitucional: String
        - password: String
        - nombres: String
        - apellidos: String
        - telefono: String
        --
        + MiembroFIS()
        + getNombresCompletos(): String
        + autenticar(password: String): boolean
        + getNumeroUnico(): String
        + setNumeroUnico(numeroUnico: String): void
        + getCedula(): String
        + getCorreoInstitucional(): String
        + getNombres(): String
        + getApellidos(): String
    }
    
    class Director <<Dominio>> {
        - especialidad: String
        - proyectoAsignado: ProyectoInvestigacion
        --
        + Director()
        + getEspecialidad(): String
        + setEspecialidad(especialidad: String): void
        + getProyectoAsignado(): ProyectoInvestigacion
        + setProyectoAsignado(proyecto: ProyectoInvestigacion): void
        + tieneProyectoAsignado(): boolean
        + registrarAyudante(ayudante: Ayudante): void
        + darDeBajaAyudante(ayudante: Ayudante, motivo: String, fecha: Date): void
        + consultarAyudantesDelProyecto(): List<Ayudante>
        + verMensajesRecibidos(): List<Mensaje>
        + responderMensaje(mensaje: Mensaje, respuesta: String): void
    }
    
    class JefeDepartamento <<Dominio>> {
        - {static} instancia: JefeDepartamento
        - especialidad: String
        - fechaInicioGestion: Date
        --
        - JefeDepartamento()
        + {static} getInstancia(): JefeDepartamento
        + getEspecialidad(): String
        + getFechaInicioGestion(): Date
        + consultarTodosProyectos(): List<ProyectoInvestigacion>
        + consultarTodosAyudantes(): List<Ayudante>
        + consultarAyudantesPorProyecto(proyecto: ProyectoInvestigacion): List<Ayudante>
        + consultarAyudantesPorCarrera(carrera: String): List<Ayudante>
        + consultarAyudantesActivos(): List<Ayudante>
        + enviarMensajeADirector(proyecto: ProyectoInvestigacion, mensaje: String): void
        + generarReporte(tipo: String): Reporte
        + recibirNotificacion(notif: Notificacion): void
        + getNotificaciones(): List<Notificacion>
    }
    
    class Ayudante <<Dominio>> {
        - carrera: String
        - nivel: int
        - promedio: float
        - estado: String
        - fechaRegistro: Date
        - fechaFinalizacion: Date
        - motivoSalida: String
        - proyectoAsignado: ProyectoInvestigacion
        --
        + Ayudante()
        + Ayudante(numeroUnico: String, nombres: String, apellidos: String, carrera: String, nivel: int)
        + getCarrera(): String
        + setCarrera(carrera: String): void
        + getNivel(): int
        + setNivel(nivel: int): void
        + getPromedio(): float
        + getEstado(): String
        + setEstado(estado: String): void
        + getFechaRegistro(): Date
        + setFechaRegistro(fecha: Date): void
        + getFechaFinalizacion(): Date
        + setFechaFinalizacion(fecha: Date): void
        + getMotivoSalida(): String
        + setMotivoSalida(motivo: String): void
        + getProyectoAsignado(): ProyectoInvestigacion
        + setProyectoAsignado(proyecto: ProyectoInvestigacion): void
        + esActivo(): boolean
        + darDeBaja(motivo: String, fecha: Date): void
        + reactivar(): void
        + calcularDiasContratado(): int
    }
    
    enum TipoProyecto <<Dominio>> {
        INTERNO
        SEMILLA
        GRUPALES
        VINCULACION_CON_FINANCIAMIENTO
        TRANSFERENCIA_TECNOLOGICA
        --
        + getDescripcion(): String
    }
    
    class ProyectoInvestigacion <<Dominio>> {
        - codigoProyecto: String
        - nombreProyecto: String
        - descripcion: String
        - fechaInicio: Date
        - fechaFin: Date
        - presupuesto: float
        - tipoProyecto: TipoProyecto
        - ayudantesPlanificados: int
        - director: Director
        - ayudantes: List<Ayudante>
        --
        + ProyectoInvestigacion()
        + ProyectoInvestigacion(codigo: String, nombre: String, tipo: TipoProyecto)
        + getCodigoProyecto(): String
        + setCodigoProyecto(codigo: String): void
        + getNombreProyecto(): String
        + setNombreProyecto(nombre: String): void
        + getDescripcion(): String
        + getTipoProyecto(): TipoProyecto
        + setTipoProyecto(tipo: TipoProyecto): void
        + getAyudantesPlanificados(): int
        + setAyudantesPlanificados(cantidad: int): void
        + getDirector(): Director
        + setDirector(director: Director): void
        + getAyudantes(): List<Ayudante>
        + agregarAyudante(ayudante: Ayudante): void
        + removerAyudante(ayudante: Ayudante): void
        + getAyudantesContratados(): int
        + getAyudantesActivos(): int
        + cumpleMetaAyudantes(): boolean
        + necesitaMasAyudantes(): boolean
        + getFaltanteAyudantes(): int
    }
    
    class Mensaje <<Dominio>> {
        - idMensaje: String
        - fecha: Date
        - asunto: String
        - contenido: String
        - remitente: MiembroFIS
        - destinatario: MiembroFIS
        - proyectoRelacionado: ProyectoInvestigacion
        - leido: boolean
        - respuesta: String
        - fechaRespuesta: Date
        --
        + Mensaje()
        + Mensaje(remitente: MiembroFIS, destinatario: MiembroFIS, contenido: String)
        + getIdMensaje(): String
        + setIdMensaje(id: String): void
        + getFecha(): Date
        + getAsunto(): String
        + setAsunto(asunto: String): void
        + getContenido(): String
        + setContenido(contenido: String): void
        + getRemitente(): MiembroFIS
        + getDestinatario(): MiembroFIS
        + getProyectoRelacionado(): ProyectoInvestigacion
        + setProyectoRelacionado(proyecto: ProyectoInvestigacion): void
        + isLeido(): boolean
        + marcarComoLeido(): void
        + getRespuesta(): String
        + setRespuesta(respuesta: String): void
        + getFechaRespuesta(): Date
        + tieneRespuesta(): boolean
        + responder(respuesta: String): void
    }
}

' ==================== GESTORES (SRP) ====================

package "Gestores" {
    
    class GeneradorNotificaciones <<Gestor>> {
        --
        + generarNotificacionNuevoAyudante(ayudante: Ayudante, proyecto: ProyectoInvestigacion): Notificacion
        + generarNotificacionAyudanteDadoDeBaja(ayudante: Ayudante, proyecto: ProyectoInvestigacion): Notificacion
    }
    
    class Notificacion <<Gestor>> {
        - idNotificacion: String
        - fecha: Date
        - mensaje: String
        - tipo: String
        - leida: boolean
        --
        + Notificacion()
        + Notificacion(mensaje: String, tipo: String)
        + getIdNotificacion(): String
        + getFecha(): Date
        + getMensaje(): String
        + getTipo(): String
        + isLeida(): boolean
        + marcarComoLeida(): void
    }
    
    class GeneradorReportes <<Gestor>> {
        --
        + generarReporteGeneral(proyectos: List, ayudantes: List): Reporte
        + generarReportePorProyecto(proyecto: ProyectoInvestigacion): Reporte
        + generarReportePorCarrera(carrera: String, ayudantes: List): Reporte
        + generarReportePorNivel(nivel: int, ayudantes: List): Reporte
    }
    
    class Reporte <<Gestor>> {
        - idReporte: String
        - fechaGeneracion: Date
        - tipo: String
        - titulo: String
        - contenido: String
        - listaAyudantes: List<Ayudante>
        --
        + Reporte()
        + Reporte(tipo: String, titulo: String)
        + getIdReporte(): String
        + getTitulo(): String
        + getContenido(): String
        + agregarAyudante(ayudante: Ayudante): void
        + exportarPDF(): File
        + exportarExcel(): File
    }
}

' ==================== SISTEMA (SINGLETON) ====================

package "Sistema" {
    
    class SistemaGestionAyudantes <<Sistema>> {
        - {static} instancia: SistemaGestionAyudantes
        - proyectoDAO: ProyectoDAO
        - ayudanteDAO: AyudanteDAO
        - miembroDAO: MiembroFISDAO
        - mensajeDAO: MensajeDAO
        - generadorNotif: GeneradorNotificaciones
        - generadorReportes: GeneradorReportes
        --
        - SistemaGestionAyudantes()
        + {static} getInstancia(): SistemaGestionAyudantes
        + inicializarSistema(): void
        + autenticarUsuario(correo: String, password: String): MiembroFIS
        + registrarAyudante(ayudante: Ayudante, proyecto: ProyectoInvestigacion): boolean
        + actualizarAyudante(ayudante: Ayudante): boolean
        + darDeBajaAyudante(ayudante: Ayudante, motivo: String, fecha: Date): boolean
        + consultarProyectos(): List<ProyectoInvestigacion>
        + consultarProyectoPorCodigo(codigo: String): ProyectoInvestigacion
        + consultarProyectoPorDirector(director: Director): ProyectoInvestigacion
        + consultarAyudantes(): List<Ayudante>
        + consultarAyudantesPorProyecto(proyecto: ProyectoInvestigacion): List<Ayudante>
        + consultarAyudantesPorCarrera(carrera: String): List<Ayudante>
        + consultarAyudantesPorNivel(nivel: int): List<Ayudante>
        + consultarAyudantesActivos(): List<Ayudante>
        + buscarAyudantes(criterio: String): List<Ayudante>
        + enviarMensaje(mensaje: Mensaje): boolean
        + consultarMensajesPorDestinatario(destinatario: MiembroFIS): List<Mensaje>
        + responderMensaje(mensaje: Mensaje, respuesta: String): boolean
        + notificarJefa(notificacion: Notificacion): void
    }
}

' ==================== CAPA DE PERSISTENCIA ====================

package "Persistencia (DAO)" {
    
    interface IDAO <<Persistencia>> {
        + guardar(entidad: Object): boolean
        + buscarPorId(id: String): Object
        + listarTodos(): List<Object>
        + actualizar(entidad: Object): boolean
        + eliminar(id: String): boolean
    }
    
    class ProyectoDAO <<Persistencia>> {
        - nombreArchivo: String
        --
        + guardar(proyecto: ProyectoInvestigacion): boolean
        + buscarPorId(id: String): ProyectoInvestigacion
        + buscarPorCodigo(codigo: String): ProyectoInvestigacion
        + buscarPorDirector(director: Director): ProyectoInvestigacion
        + listarTodos(): List<ProyectoInvestigacion>
        + actualizar(proyecto: ProyectoInvestigacion): boolean
    }
    
    class AyudanteDAO <<Persistencia>> {
        - nombreArchivo: String
        --
        + guardar(ayudante: Ayudante): boolean
        + buscarPorId(id: String): Ayudante
        + buscarPorNumeroUnico(numeroUnico: String): Ayudante
        + buscarPorProyecto(codigoProyecto: String): List<Ayudante>
        + buscarPorCarrera(carrera: String): List<Ayudante>
        + buscarPorNivel(nivel: int): List<Ayudante>
        + buscarActivos(): List<Ayudante>
        + listarTodos(): List<Ayudante>
        + actualizar(ayudante: Ayudante): boolean
    }
    
    class MiembroFISDAO <<Persistencia>> {
        - nombreArchivo: String
        --
        + guardar(miembro: MiembroFIS): boolean
        + buscarPorCorreo(correo: String): MiembroFIS
        + validarCredenciales(correo: String, password: String): MiembroFIS
        + listarTodos(): List<MiembroFIS>
    }
    
    class MensajeDAO <<Persistencia>> {
        - nombreArchivo: String
        --
        + guardar(mensaje: Mensaje): boolean
        + buscarPorId(id: String): Mensaje
        + buscarPorDestinatario(destinatario: MiembroFIS): List<Mensaje>
        + buscarPorRemitente(remitente: MiembroFIS): List<Mensaje>
        + buscarNoLeidos(destinatario: MiembroFIS): List<Mensaje>
        + listarTodos(): List<Mensaje>
        + actualizar(mensaje: Mensaje): boolean
    }
}

' ==================== CAPA DE CONTROLADORES ====================

package "Controladores" {
    
    class ControladorAutenticacion <<Controlador>> {
        - sistema: SistemaGestionAyudantes
        --
        + autenticar(correo: String, password: String): MiembroFIS
        + cerrarSesion(): void
    }
    
    class ControladorDirector <<Controlador>> {
        - sistema: SistemaGestionAyudantes
        - directorActual: Director
        --
        + inicializar(director: Director): void
        + registrarAyudante(datos: Map<String, Object>): Ayudante
        + actualizarAyudante(ayudante: Ayudante, datos: Map): boolean
        + darDeBajaAyudante(ayudante: Ayudante, motivo: String, fecha: Date): boolean
        + consultarMiProyecto(): ProyectoInvestigacion
        + consultarAyudantesDeProyecto(): List<Ayudante>
        + consultarAyudantesActivos(): List<Ayudante>
        + verMensajesRecibidos(): List<Mensaje>
        + responderMensaje(mensaje: Mensaje, respuesta: String): boolean
    }
    
    class ControladorJefaDepartamento <<Controlador>> {
        - sistema: SistemaGestionAyudantes
        - jefa: JefeDepartamento
        --
        + inicializar(): void
        + consultarProyectos(): List<ProyectoInvestigacion>
        + consultarAyudantes(): List<Ayudante>
        + consultarAyudantesPorProyecto(proyecto: ProyectoInvestigacion): List<Ayudante>
        + filtrarAyudantesPorCarrera(carrera: String): List<Ayudante>
        + filtrarAyudantesPorNivel(nivel: int): List<Ayudante>
        + filtrarAyudantesActivos(): List<Ayudante>
        + buscarAyudantes(criterio: String): List<Ayudante>
        + generarReporte(tipo: String): Reporte
        + enviarMensajeADirector(proyecto: ProyectoInvestigacion, mensaje: String): boolean
        + consultarNotificaciones(): List<Notificacion>
        + exportarReportePDF(reporte: Reporte): File
    }
}

' ==================== CAPA DE PRESENTACIÓN ====================

package "Vistas (UI)" {
    
    class VistaLogin <<Vista>> {
        - txtCorreo: JTextField
        - txtPassword: JPasswordField
        - btnIngresar: JButton
        --
        + mostrar(): void
        + obtenerCredenciales(): Map<String, String>
        + mostrarError(mensaje: String): void
    }
    
    class VistaDirector <<Vista>> {
        - tablaAyudantes: JTable
        - panelProyecto: JPanel
        - btnRegistrarAyudante: JButton
        - btnDarDeBaja: JButton
        - panelMensajes: JPanel
        - listaMensajes: JList
        --
        + inicializar(): void
        + mostrar(): void
        + actualizarTablaAyudantes(ayudantes: List): void
        + actualizarDatosProyecto(proyecto: ProyectoInvestigacion): void
        + mostrarFormularioAyudante(): Map<String, Object>
        + mostrarDialogoDarDeBaja(): Map<String, Object>
        + mostrarMensajesRecibidos(mensajes: List<Mensaje>): void
        + mostrarDialogoRespuesta(mensaje: Mensaje): String
        + mostrarMensaje(mensaje: String): void
    }
    
    class VistaJefaDepartamento <<Vista>> {
        - tabPrincipal: JTabbedPane
        - tablaAyudantes: JTable
        - comboFiltro: JComboBox
        - txtBuscar: JTextField
        - btnBuscar: JButton
        - comboTipoReporte: JComboBox
        - btnGenerarReporte: JButton
        - btnEnviarMensaje: JButton
        - panelNotificaciones: JPanel
        --
        + inicializar(): void
        + mostrar(): void
        + actualizarTablaAyudantes(ayudantes: List): void
        + aplicarFiltro(tipo: String, valor: String): void
        + buscarAyudantes(criterio: String): void
        + mostrarDialogoReporte(): String
        + mostrarDialogoEnviarMensaje(proyecto: ProyectoInvestigacion): String
        + mostrarNotificaciones(notificaciones: List): void
        + descargarReporte(archivo: File): void
    }
}

' ==================== RELACIONES DE HERENCIA ====================

MiembroFIS <|-- Director
MiembroFIS <|-- JefeDepartamento
MiembroFIS <|-- Ayudante

IDAO <|.. ProyectoDAO
IDAO <|.. AyudanteDAO
IDAO <|.. MiembroFISDAO
IDAO <|.. MensajeDAO

' ==================== RELACIONES DE DOMINIO ====================

ProyectoInvestigacion "0..1" -- "1" Director : < dirigidoPor
ProyectoInvestigacion "1" o-- "0..*" Ayudante : < tiene
ProyectoInvestigacion "1" -- "1" TipoProyecto : < es de tipo

Ayudante "0..*" -- "0..1" ProyectoInvestigacion : asignadoA >

Mensaje "0..*" -- "1" MiembroFIS : enviadoPor >
Mensaje "0..*" -- "1" MiembroFIS : recibidoPor >
Mensaje "0..*" o-- "0..1" ProyectoInvestigacion : relacionadoCon >

' ==================== RELACIONES GESTORES ====================

GeneradorNotificaciones ..> Notificacion : << crea >>
Notificacion "0..*" --> "1" JefeDepartamento : notificaA >

GeneradorReportes ..> Reporte : << genera >>

' ==================== RELACIONES SISTEMA ====================

SistemaGestionAyudantes --> ProyectoDAO : usa
SistemaGestionAyudantes --> AyudanteDAO : usa
SistemaGestionAyudantes --> MiembroFISDAO : usa
SistemaGestionAyudantes --> MensajeDAO : usa
SistemaGestionAyudantes --> GeneradorNotificaciones : usa
SistemaGestionAyudantes --> GeneradorReportes : usa

' ==================== RELACIONES CONTROLADORES ====================

ControladorAutenticacion --> SistemaGestionAyudantes : usa
ControladorDirector --> SistemaGestionAyudantes : usa
ControladorDirector --> Director : maneja
ControladorJefaDepartamento --> SistemaGestionAyudantes : usa
ControladorJefaDepartamento --> JefeDepartamento : maneja

' ==================== RELACIONES VISTAS ====================

VistaLogin --> ControladorAutenticacion : usa
VistaDirector --> ControladorDirector : usa
VistaJefaDepartamento --> ControladorJefaDepartamento : usa

@enduml